{
  "name": "kulden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "desktop:prepare": "npm run build && tsc -p tsconfig.desktop.json --noEmit && node scripts/build-desktop.mjs",
    "desktop:exe": "npm run desktop:prepare && electron-builder --config electron-builder.json --win nsis --x64 --publish never",
    "test:lan": "vitest run desktop/lanServer.test.ts desktop/discovery.test.ts src/commands.test.ts src/NetworkPanel.test.tsx",
    "test:android-discovery": "node scripts/test-android-discovery.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "vitest": "latest"
  }
}
